{
  "version": 2,
  "functions": {
    "api/analysis.js": {
      "runtime": "@vercel/node@2",
      "maxDuration": 300,
      "memory": 2048
    },
    "api/market.py": {
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/api/analysis(?:/.*)?", "dest": "/api/analysis.js" },
    { "src": "/api/market(?:/.*)?", "dest": "/api/market.py" }
  ]
}

