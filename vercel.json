{
  "version": 2,
  "functions": {
    "api/analysis.js": {
      "runtime": "nodejs18.x",
      "maxDuration": 300,
      "memory": 2048
    }
  },
  "routes": [
    { "src": "/api/analysis(?:/.*)?", "dest": "/api/analysis.js" },
    { "src": "/api/market(?:/.*)?", "dest": "/api/market.py" }
  ]
}

