{
  "version": 2,
  "functions": {
    "api/analysis.js": {
      "maxDuration": 300,
      "memory": 2048,
      "excludeFiles": "{.next,*.cache,node_modules/.cache,dist,web-build,out,data,ios,android,.expo}/**"
    },
    "api/market.py": {
      "excludeFiles": "{.next,*.cache,node_modules,dist,web-build,out,data,ios,android,.expo}/**"
    }
  },
  "routes": [
    { "src": "/api/analysis(?:/.*)?", "dest": "/api/analysis.js" },
    { "src": "/api/market(?:/.*)?", "dest": "/api/market.py" }
  ]
}

